# ═══════════════════════════════════════════════════════
#  IXBrowser Automation – Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# --- IXBrowser Local API ---
IXBROWSER_HOST=127.0.0.1
IXBROWSER_PORT=53200
IXBROWSER_MAX_CONCURRENT=3

# --- OpenAI / LLM (for Page-Agent) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Page-Agent ---
PAGE_AGENT_CDN=https://cdn.jsdelivr.net/npm/page-agent@latest/dist/iife/page-agent.js
PAGE_AGENT_LANGUAGE=en-US

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=[]

# --- FastAPI Server ---
API_HOST=127.0.0.1
API_PORT=8000
API_BEARER_TOKEN=

# --- OpenFang ---
OPENFANG_URL=http://127.0.0.1:3000

# --- Task Defaults ---
TASK_MIN_DELAY=2.0
TASK_MAX_DELAY=8.0
TASK_TIMEOUT=300.0
TASK_MAX_RETRIES=2

# --- Automation Engine ---
AUTOMATION_DB_PATH=./data/automation.db
# Defaults to a sibling checkout at ..\artemis. Leave ARTEMIS_PYTHON blank
# to auto-detect its .venv; set an absolute path if it is elsewhere.
ARTEMIS_ROOT=..\artemis
ARTEMIS_PYTHON=
# Use "adb" when Android platform-tools is on PATH, otherwise set its full path.
ADB_PATH=adb
