# ═══════════════════════════════════════════════════════
#  IXBrowser Automation – Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# --- IXBrowser Local API ---
IXBROWSER_HOST=127.0.0.1
IXBROWSER_PORT=53200
IXBROWSER_MAX_CONCURRENT=3

# --- OpenAI / LLM (for Page-Agent) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Page-Agent ---
PAGE_AGENT_CDN=https://cdn.jsdelivr.net/npm/page-agent@latest/dist/iife/page-agent.js
PAGE_AGENT_LANGUAGE=en-US

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=[]

# --- FastAPI Server ---
API_HOST=127.0.0.1
API_PORT=8000

# --- OpenFang ---
OPENFANG_URL=http://127.0.0.1:3000

# --- Task Defaults ---
TASK_MIN_DELAY=2.0
TASK_MAX_DELAY=8.0
TASK_TIMEOUT=300.0
TASK_MAX_RETRIES=2
