{
  "name": "n8n-nodes-autoixb",
  "version": "0.1.0",
  "description": "Run saved autoIXB browser automations from n8n",
  "license": "UNLICENSED",
  "main": "index.js",
  "files": [
    "index.js",
    "dist",
    "nodes",
    "credentials",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.cjs"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/AutoIXB/AutoIXB.node.js"
    ],
    "credentials": [
      "dist/credentials/AutoIxbApi.credentials.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "n8n-workflow": "2.42.2",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "n8n-workflow": "^2.42.0"
  }
}
